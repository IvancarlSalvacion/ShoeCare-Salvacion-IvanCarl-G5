# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Option A - Supabase (Project Settings > Database > Connection string > URI)
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True

# Option B - local PostgreSQL
DB_NAME=shoecare
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
